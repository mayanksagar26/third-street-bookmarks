{
  "name": "third-street-bookmarks",
  "version": "2.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "setup": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently \"node server/index.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js client/src/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
